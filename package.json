{
  "name": "lightweightproject",
  "version": "0.0.1",
  "description": "This is a lightweight NodeJS project for training, learning and practicing.",
  "author": "https://github.com/MarkDanilchenko",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "engines": {
    "node": ">=26.0.0"
  },
  "imports": {
    "#server/*": [
      "./server/dist/src/*.js",
      "./server/dist/src/*/index.js",
      "./server/dist/src/*"
    ],
    "#shared/*": [
      "./shared/*.js",
      "./shared/*/index.js",
      "./shared/*"
    ]
  },
  "scripts": {
    "build:server": "cd server && rm -rf ./dist && nest build --config ./nest-cli.json && tsc-alias -p ./tsconfig.json",
    "clear:server": "cd server && rm -rf ./dist",
    "clear:node_modules": "rm -rf ./node_modules",
    "start:server": "cd server && nest start --config ./nest-cli.json",
    "start:server:dev": "cd server && nest start --watch --config ./nest-cli.json",
    "start:server:debug": "cd server && nest start --debug --watch --config ./nest-cli.json",
    "start:server:prod": "cd server && node ./dist/src/main",
    "start:microservice:rmq": "cd server && ts-node -r tsconfig-paths/register ./src/microservice.rmq.ts",
    "start:microservice:rmq:dev": "cd server && nodemon --watch 'src/**/*.ts' --exec ts-node -r tsconfig-paths/register ./src/microservice.rmq.ts",
    "start:microservice:rmq:prod": "cd server && node ./dist/src/microservice.rmq.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "typeorm:create": "npm run typeorm migration:create",
    "typeorm:run": "npm run typeorm migration:run -- -d ./server/src/configs/typeorm.configuration.ts",
    "typeorm:revert": "npm run typeorm migration:revert -- -d ./server/src/configs/typeorm.configuration.ts",
    "typeorm:generate": "npm run typeorm migration:generate -- -d ./server/src/configs/typeorm.configuration.ts",
    "typeorm:show": "npm run typeorm migration:show -- -d ./server/src/configs/typeorm.configuration.ts",
    "test:server:unit": "NODE_ENV=test vitest run --config ./server/tests/vitest.config.mts",
    "test:server:unit:cov": "NODE_ENV=test vitest run --config ./server/tests/vitest.config.mts --coverage",
    "test:server:e2e": "NODE_ENV=test vitest run --config ./server/tests/vitest-e2e.config.mts",
    "test:server:e2e:cov": "NODE_ENV=test vitest run --config ./server/tests/vitest-e2e.config.mts --coverage",
    "clear:test:server:cov": "rm -rf ./server/tests/coverage",
    "tsc": "tsc --noEmit",
    "lint:server": "eslint ./server/src/**/*.ts server/tests/**/*.ts ./server/migrations/**/*.ts",
    "format:server": "prettier --write ./server/src/**/*.ts  ./server/tests/**/*.ts ./server/migrations/**/*.ts && eslint ./server/src/**/*.ts ./server/tests/**/*.ts ./server/migrations/**/*.ts --fix",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@adminjs/express": "6.1.1",
    "@adminjs/nestjs": "7.0.0",
    "@adminjs/themes": "1.0.1",
    "@adminjs/typeorm": "5.0.1",
    "@nestjs/axios": "12.0.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/event-emitter": "12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/microservices": "12.1.3",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "@node-saml/passport-saml": "5.1.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "adminjs": "7.8.17",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.2.0",
    "axios": "1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.8",
    "ejs": "7.0.1",
    "express-formidable": "1.2.0",
    "express-session": "1.19.0",
    "ioredis": "6.0.0",
    "nest-winston": "2.0.0",
    "nodemailer": "10.1.1",
    "passport": "0.7.0",
    "passport-github2": "0.1.12",
    "passport-google-oauth20": "2.0.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "passport-oauth2": "1.8.0",
    "passport-yandex": "0.0.5",
    "patch-package": "8.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typeorm": "1.1.2",
    "uuid": "14.0.3",
    "winston": "3.19.0",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@swc/cli": "0.6.0",
    "@swc/core": "1.16.18",
    "@types/amqplib": "0.10.8",
    "@types/cookie-parser": "1.4.10",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/ioredis": "5.0.0",
    "@types/node": "26.6.5",
    "@types/passport-github2": "1.2.9",
    "@types/passport-google-oauth20": "2.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@types/passport-saml": "1.1.7",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.13.0",
    "nodemon": "3.1.14",
    "prettier": "3.9.10",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%",
    "not ie < 10"
  ]
}
